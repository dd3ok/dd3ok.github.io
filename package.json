{
  "name": "dd3ok.github.io",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "npm run validate && node node_modules/next/dist/bin/next build && npm run smoke",
    "start": "node node_modules/serve/build/main.js out -l 3000",
    "lint": "node node_modules/eslint/bin/eslint.js . --max-warnings=0",
    "smoke": "node scripts/smoke-check.mjs",
    "analyze": "node node_modules/next/dist/bin/next experimental-analyze --output",
    "validate": "npm run test:notes-import && npm run test:notes-categories && npm run test:projects-data && npm run test:agent-skills-data && npm run test:wake-messaging && npm run design:check && npm run lint && node node_modules/typescript/bin/tsc --noEmit && npm run notes:check",
    "design:check": "node scripts/check-design-system.mjs",
    "test:wake-messaging": "node scripts/check-wake-messaging.mjs",
    "notes:import:waitworthy": "node scripts/import-waitworthy-notes.mjs",
    "notes:check": "node scripts/check-notes.mjs",
    "test:notes-import": "node scripts/test-import-waitworthy-notes.mjs",
    "test:notes-categories": "node scripts/test-notes-categories.mjs",
    "test:projects-data": "node scripts/check-projects-data.mjs",
    "test:agent-skills-data": "node scripts/check-agent-skills-data.mjs",
    "preview": "npm run build && node node_modules/serve/build/main.js out -l 3000"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "next": "^16.2.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-use-websocket": "^4.13.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.16",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "description": "Static-exported personal portfolio for dd3ok, built with Next.js App Router and TypeScript.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dd3ok/dd3ok.github.io.git"
  },
  "keywords": [],
  "author": "dd3ok",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/dd3ok/dd3ok.github.io/issues"
  },
  "homepage": "https://github.com/dd3ok/dd3ok.github.io#readme"
}
